all: simpleshell simplescheduler  counterjob fibjob printerjob

simpleshell: 
	gcc -o simpleshell simple_shell.c

simplescheduler: 
	gcc -o simplescheduler simple_scheduler.c

counterjob: 
	gcc -o counterjob counter_job.c

fibjob: 
	gcc -o fibjob fib_job.c

printerjob: 
	gcc -o printerjob printer_job.c

clean:
	rm -f simpleshell simplescheduler  counterjob fibjob printerjob